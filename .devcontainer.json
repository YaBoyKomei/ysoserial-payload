// .devcontainer/devcontainer.json
{
  "name": "ysoserial Windows",
  "image": "mcr.microsoft.com/devcontainers/windows:ltsc2022",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:1": {
      "version": "8.0",
      "version": "4.8"
    }
  },
  "postCreateCommand": "powershell -Command \"Set-ExecutionPolicy RemoteSigned -Scope CurrentUser\""
}
